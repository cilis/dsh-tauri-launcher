{
  "name": "@lenorin/dsh-tauri-launcher",
  "version": "1.1.2",
  "description": "DSH Web 插件：基于 Tauri 2 的 DeepSeek Harness 桌面启动器，自动联动桌面快捷方式，exe 路径与探测窗口可配置。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "launcher/bin",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cilis/dsh-tauri-launcher.git"
  },
  "homepage": "https://github.com/cilis/dsh-tauri-launcher#readme",
  "bugs": {
    "url": "https://github.com/cilis/dsh-tauri-launcher/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.5-rc.1 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.1": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "passed" },
        "0.2.0-rc.2": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "passed" },
        "0.2.1-alpha.1": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "passed" }
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
